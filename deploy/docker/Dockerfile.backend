# MyCourse Backend Dockerfile
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY . /app

# Install Python dependencies (use Aliyun mirror for China)
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ -r repos/backend/requirements.txt

# Create directory for database
RUN mkdir -p /var/www/mycourse/db && chmod 755 /var/www/mycourse/db

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/api/health || exit 1

# Run uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
